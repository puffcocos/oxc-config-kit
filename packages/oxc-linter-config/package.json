{
  "name": "@cocopalm/oxc-linter-config",
  "version": "0.2.0",
  "description": "oxc linter configuration",
  "author": "puffcocos",
  "license": "MIT",
  "type": "module",
  "main": "./dist/base.mjs",
  "exports": {
    "./base": {
      "import": "./dist/base.mjs",
      "types": "./dist/base.d.mts"
    },
    "./react": {
      "import": "./dist/react.mjs",
      "types": "./dist/react.d.mts"
    },
    "./node": {
      "import": "./dist/node.mjs",
      "types": "./dist/node.d.mts"
    },
    "./react-compiler": {
      "import": "./dist/react-compiler.mjs",
      "types": "./dist/react-compiler.d.mts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "keywords": [
    "oxc",
    "linter",
    "config"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/puffcocos/oxc-config-kit"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "oxlint": "^1.57.0",
    "tsdown": "^0.21.6",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "oxlint": "^1.57.0",
    "eslint-plugin-react-hooks": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-react-hooks": {
      "optional": true
    }
  }
}
